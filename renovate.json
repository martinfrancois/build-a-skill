{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "pinDigests": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "dependencyDashboardApproval": false,
  "separateMajorMinor": true,
  "separateMultipleMajor": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "rebaseWhen": "conflicted",
  "schedule": [
    "* * * * 5"
  ],
  "updateNotScheduled": false,
  "packageRules": [
    {
      "description": "Merge eligible non-major updates after checks pass.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates require human review of migration notes.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major update"
      ]
    },
    {
      "description": "Private repository: combine eligible automatic updates after package-specific rules to conserve Actions minutes. Keep existing review requirements unchanged.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchJsonata": [
        "automerge = true"
      ],
      "groupName": "Routine dependency updates",
      "groupSlug": "routine-dependencies"
    },
    {
      "description": "Private repository: bundle review-required updates without enabling automerge. Keep majors separate from reviewed non-major updates so incompatible major upgrades do not block other reviewed fixes.",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchJsonata": [
        "$not(automerge = true)"
      ],
      "groupName": "Reviewed dependency updates",
      "groupSlug": "reviewed-dependencies",
      "automerge": false
    }
  ]
}
